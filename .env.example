# Sudarshana Chakra - environment secrets template
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` - it is git-ignored; only this template is tracked.

# Google Gemini API key (Gemini Live voice + Gemini text model / vision).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# NVIDIA NIM API key (used when default_ai_provider = "NVIDIA").
# Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# Optional: OpenRouter API key (legacy provider / fallback).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Licensing & commercial distribution (leave blank for an unlocked dev build)
# ---------------------------------------------------------------------------
# Turn license/trial enforcement ON for commercial builds only.
# When unset/false the app is fully unlocked and integrity checks warn only.
LICENSING_ENABLED=false

# Free-trial length in days (default 8).
SUDARSHANA_TRIAL_DAYS=8

# Base64-encoded RSA public key (PEM body) used to verify signed license keys.
# Generate with: python -c "import base64;print(base64.b64encode(open('license_pub.pem','rb').read()).decode())"
SUDARSHANA_LICENSE_PUBKEY=

# Which vendor issued the keys: lemonsqueezy | payhip | gumroad | offline.
# Leave blank to auto-detect from the key's shape.
LICENSE_PROVIDER=

# Checkout URL opened by the "Buy Now" button in the paywall.
SUDARSHANA_PURCHASE_URL=https://sudarshanachakra.ai/buy

# Optional per-vendor checkout links (override the single URL above).
LEMONSQUEEZY_CHECKOUT_URL=
PAYHIP_CHECKOUT_URL=
GUMROAD_CHECKOUT_URL=

# Optional vendor API credentials (only needed for their verify endpoints).
PAYHIP_API_KEY=
PAYHIP_PRODUCT_LINK=
GUMROAD_PRODUCT_ID=

# Extra/override discount codes as JSON, e.g. {"CHAKRA50":50,"CHAKRA80":80}
SUDARSHANA_DISCOUNT_CODES=
